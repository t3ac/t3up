

TCEFORM.tt_content.CType.removeItems(
	text,textpic,image,header
	div,html,bullet,
	menu_sitemap,menu_sitemap_pages,menu_abstract,menu_subpages
) 





TCEFORM.tt_content.header_position.disabled = 1
TCEFORM.tt_content.subheader.disabled = 1
TCEFORM.tt_content.date.disabled = 1

TCEFORM.tt_content.imagewidth.disabled = 1
TCEFORM.tt_content.imageheight.disabled = 1
TCEFORM.tt_content.imageborder.disabled = 1




// HEADER Layout 
TCAdefaults.tt_content.header_layout.config.items.0.label = H1

TCEFORM.tt_content {
    header_layout {
        config.default = 2
        altLabels {
             # 0 = Default ( = h2)
             1 = H1
             2 = H2
             3 = H3
             4 = H4
             5 = H5
       }
       removeItems =  0,1,5
      }
   }
}


// DESIGNS
TCEFORM {
	tt_content {
		frame_class {
			removeItems = ruler-before, ruler-after, indent, indent-left, indent-right
			disableNoMatchingValueElement = 1
            types {
				text {
					addItems { 
                        	white  		= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:white
                   		colored		= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:colored
					}
				} 
				textmedia {
					addItems { 
                    	    white  		= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:white
                   		colored		= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:colored
					}
				}   
				table {
					addItems { 
                    	   white  		= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:white
					}
				}  				
				header {
					addItems { 
                    	   white  		= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:white
					}
	            }  
				list {
					addItems { 
                    	   white  			= LLL:EXT:t3up/Resources/Private/Language/locallang_backend.xlf:white
					}
	            }  
	            menu_subpages {
					addItems { 
						subnavigation 	= Subnavigation
					}
	            }  
			} // types
		} // frame_class
	} // tt_content  
} // TCEFORM
